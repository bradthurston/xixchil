<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Auto-attach: when the board is plugged in, offer to open the app.
                 The device_filter restricts this to ESP32-class serial bridges so
                 the prompt doesn't fire for every USB device. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />

            <!-- Import: "Share → Xixchil" from another app (NRSuite's portal
                 export, a file manager, a browser download). A shared file arrives as
                 a content:// URI with a temporary read grant, so no storage permission
                 is involved. Restricted to the capture and hash types rather than */*
                 so the app does not appear in every share sheet on the phone. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.tcpdump.pcap" />
                <data android:mimeType="application/x-pcapng" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Import: opening a capture or hash file directly, from a file manager
                 or a download notification. Extensions cannot be matched on ACTION_SEND,
                 only on a VIEW with a path, so both filters are needed. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.tcpdump.pcap" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.22000" />
                <data android:pathPattern=".*\\.pcap" />
                <data android:pathPattern=".*\\.cap" />
                <data android:pathPattern=".*\\.pcapng" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Geolocation: wardrive tags every captured handshake with a GPS fix, so the
         Capacitor Geolocation plugin needs these declared here *and* granted at
         runtime (Android 6+). With them missing, watchPosition's callback fires
         with "Location permissions are not declared in manifest" and every
         wardriving point is logged with no position. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- USB host: the whole point of this app. required="true" keeps the store
         from offering it to devices that cannot do USB-OTG at all. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
</manifest>
