<?xml version="1.0" encoding="utf-8"?>
<!-- USB devices that should offer to open Xixchil on attach.
     Kept narrow on purpose: the ESP32-S3 exposes three relevant VID/PID pairs
     depending on which port is used and which firmware is flashed. -->
<resources>
    <!-- Espressif native USB (USB-Serial/JTAG) — ESP32-S3/C3/S2 built-in USB -->
    <usb-device vendor-id="12346" product-id="4097" />   <!-- 0x303A:0x1001 -->
    <!-- Espressif USB CDC / JTAG variants -->
    <usb-device vendor-id="12346" product-id="4098" />   <!-- 0x303A:0x1002 -->
    <!-- Silicon Labs CP210x — the UART bridge on many ESP32 devkits -->
    <usb-device vendor-id="4292" />                       <!-- 0x10C4 -->
    <!-- WCH CH340/CH341 — the other common devkit bridge -->
    <usb-device vendor-id="6790" />                       <!-- 0x1A86 -->
    <!-- FTDI -->
    <usb-device vendor-id="1027" />                       <!-- 0x0403 -->
    <!-- Prolific PL2303 -->
    <usb-device vendor-id="1659" />                       <!-- 0x067B -->
</resources>
